{
	"name": "pi-gpt-transcribe",
	"version": "0.3.1",
	"private": false,
	"description": "Pi extension. Toggle dictation with /transcribe or Ctrl-Q — OpenAI gpt-transcribe inserts each phrase into the prompt while you keep typing. Its terminal-free core is importable as pi-gpt-transcribe/core.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"transcribe",
		"dictation",
		"stt",
		"openai",
		"gpt-transcribe"
	],
	"type": "module",
	"exports": {
		".": "./index.ts",
		"./core": {
			"types": "./dist/core.d.ts",
			"import": "./dist/core.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"index.ts",
		"src",
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json"
	},
	"license": "MIT",
	"author": "youssefsiam38",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/youssefsiam38/pi-gpt-transcribe.git"
	},
	"homepage": "https://github.com/youssefsiam38/pi-gpt-transcribe#readme",
	"bugs": {
		"url": "https://github.com/youssefsiam38/pi-gpt-transcribe/issues"
	},
	"engines": {
		"node": ">=22"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"typescript": "5.9.3",
		"@types/node": "24.7.0"
	},
	"optionalDependencies": {
		"decibri": "^5.7.0"
	}
}
